{
  "name": "worklogger-task-management",
  "private": true,
  "version": "1.0.0",
  "description": "Worklogger — Task Management. Simple, practical team task management with spaces, custom workflows, and monthly reports.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:sql": "node scripts/verify-sql.mjs",
    "lint": "tsc --noEmit",
    "db:types": "echo \"Generate types via: npx supabase gen types typescript --project-id <project-id> > src/lib/database.types.ts\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.51.0",
    "date-fns": "^3.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "react-router-dom": "^6.25.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "vite": "^6.0.0",
    "vitest": "^2.0.5"
  }
}
